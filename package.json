{
  "name": "@andrewpopov/fetch-client-kit",
  "version": "0.3.4",
  "description": "Framework-agnostic browser fetch client: a single-flight 401 -> refresh -> retry transport with pluggable auth (cookie / bearer / csrf).",
  "author": "Andrew Popov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewpopov/fetch-client-kit.git"
  },
  "homepage": "https://github.com/andrewpopov/fetch-client-kit#readme",
  "bugs": {
    "url": "https://github.com/andrewpopov/fetch-client-kit/issues"
  },
  "keywords": [
    "fetch",
    "http-client",
    "auth",
    "token-refresh",
    "401",
    "retry",
    "single-flight",
    "bearer",
    "csrf"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:dist-fresh": "node scripts/verify-dist-fresh.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:pack && npm run verify:dist-fresh",
    "release:note": "release-kit note",
    "release:notes": "release-kit notes",
    "release:bump": "release-kit bump",
    "release:cut": "release-kit cut",
    "release:check": "release-kit check",
    "release:hygiene": "release-kit hygiene",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@andrewpopov/deploy-kit": "github:andrewpopov/deploy-kit#v0.25.0",
    "@andrewpopov/release-kit": "github:andrewpopov/release-kit#v0.3.1",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
